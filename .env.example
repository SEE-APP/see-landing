# All forms (waitlist, contact message, meeting request) go through Resend from Server Actions.
# Server-only: never prefix these with NEXT_PUBLIC_. Copy this file to .env.local and set the same values in Vercel.

# Resend > API Keys. Needs "Full access": a sending-only key cannot add waitlist contacts.
RESEND_API_KEY=
# Resend > Contacts > Segments: id of the "Waitlist" segment that new signups join.
RESEND_SEGMENT_ID=
# Inbox that receives contact and meeting emails, e.g. contact@seevrce.ge
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. SEE <hello@seevrce.ge> (onboarding@resend.dev for local tests).
CONTACT_FROM_EMAIL=
